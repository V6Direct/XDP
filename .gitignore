# Build artifacts
bin/
*.o
*.a
coverage.out
coverage.html
/tmp/

# XDP compiled object (generated by scripts/build_xdp.sh)
# NOTE: Do NOT add /usr/local/lib/ddos/ here - that's outside the repo

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log
/var/

# Environment overrides (contain secrets)
*.env
!deployments/*.env.example

# Docker override files
docker-compose.override.yml

# NOTE: go.sum is intentionally NOT ignored.
# It must be committed. Generate it with: go mod tidy
