# /etc/ddos-platform/webpanel.env
# Web Panel environment variables

# Address to listen on for the web UI
PANEL_ADDR=:3000

# URL of the control plane REST API
CP_URL=http://localhost:8080

# Path to the compiled frontend static files
FRONTEND_DIR=/usr/local/share/ddos-platform/frontend

# JWT signing secret – CHANGE THIS in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_use_openssl_rand_hex_32_in_production
