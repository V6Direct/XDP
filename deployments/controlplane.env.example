# /etc/ddos-platform/controlplane.env
# Control Plane environment variables
# Copy this file to /etc/ddos-platform/controlplane.env and edit as needed

# Network interface to attach XDP to
DDOS_IFACE=eth0

# REST API listen address (controlplane internal API)
DDOS_API_ADDR=:8080

# Prometheus metrics listen address
DDOS_METRICS_ADDR=:9090
