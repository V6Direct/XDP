{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "DDoS Mitigation Platform — XDP/eBPF real-time monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Packets Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity" },
          "unit": "pps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red",    "value": 100000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "ddos_packets_per_second",
          "legendFormat": "PPS",
          "refId": "A"
        },
        {
          "expr": "rate(ddos_dropped_packets_total[30s])",
          "legendFormat": "Drop rate",
          "refId": "B"
        }
      ]
    },

    {
      "id": 2,
      "title": "Throughput (Mbps)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity" },
          "unit": "Mbits",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red",    "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ddos_bits_per_second / 1e6",
          "legendFormat": "Throughput Mbps",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Total Packets",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        { "expr": "ddos_total_packets_total", "legendFormat": "Total Packets", "refId": "A" }
      ]
    },

    {
      "id": 4,
      "title": "Dropped Packets",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "ddos_dropped_packets_total", "legendFormat": "Dropped", "refId": "A" }
      ]
    },

    {
      "id": 5,
      "title": "Blocked IPs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red",    "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "ddos_blocked_ips_count", "legendFormat": "Blocked IPs", "refId": "A" }
      ]
    },

    {
      "id": 6,
      "title": "Drop Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "ddos_dropped_packets_total / (ddos_total_packets_total + 1)",
          "legendFormat": "Drop Ratio",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "SYN Floods",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red",    "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "ddos_syn_floods_total", "legendFormat": "SYN Floods", "refId": "A" }
      ]
    },

    {
      "id": 8,
      "title": "UDP Amplifications",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red",    "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "ddos_udp_amplification_total", "legendFormat": "UDP Amp", "refId": "A" }
      ]
    },

    {
      "id": 9,
      "title": "Attack Events Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "none" } },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SYN Floods/s" },   "properties": [{ "id": "color", "value": { "fixedColor": "#FF8800", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "UDP Amp/s" },       "properties": [{ "id": "color", "value": { "fixedColor": "#FFCC00", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "ICMP Floods/s" },   "properties": [{ "id": "color", "value": { "fixedColor": "#FF3355", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        { "expr": "rate(ddos_syn_floods_total[1m])",          "legendFormat": "SYN Floods/s",   "refId": "A" },
        { "expr": "rate(ddos_udp_amplification_total[1m])",   "legendFormat": "UDP Amp/s",       "refId": "B" },
        { "expr": "rate(ddos_icmp_floods_total[1m])",         "legendFormat": "ICMP Floods/s",   "refId": "C" }
      ]
    },

    {
      "id": 10,
      "title": "Blocked IP Count Over Time",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "ddos_blocked_ips_count", "legendFormat": "Blocked IPs", "refId": "A" }
      ]
    },

    {
      "id": 11,
      "title": "Pass vs Drop Rate (30s avg)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "none" } },
          "unit": "pps"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Passed" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Dropped" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(ddos_passed_packets_total[30s])",  "legendFormat": "Passed",  "refId": "A" },
        { "expr": "rate(ddos_dropped_packets_total[30s])", "legendFormat": "Dropped", "refId": "B" }
      ]
    }

  ],

  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["ddos", "xdp", "ebpf", "security", "network"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "DDoS Mitigation Platform",
  "uid": "ddos-mitigation-v1",
  "version": 1
}
